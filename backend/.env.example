# MongoDB connection string (MongoDB Atlas free tier is fine for a pilot)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rice_trace

# The deployed Netlify URL of your frontend — QR codes will point here
FRONTEND_URL=https://matifood.netlify.app/  

# Shared secret for the admin-only endpoints (create/revoke/full record).
# Replace with real auth (JWT, OAuth, etc.) before going to production.
ADMIN_API_KEY=change-me-to-something-long-and-random

PORT=4000
